<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>et.restlink</groupId>
    <artifactId>sas-core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>sas-entitlement</artifactId>
  <name>sas-core :: sas-entitlement</name>
  <description>Entitlement-server library (packaged by sas-ecs-host): the EAP-AKA /
    EAP-AKA' wire + key-derivation code, the /ts43 and /entitlement surfaces, and the
    operator-token issuer (sas-token profile, published at /jwks.json). Depends on
    sas-common and sas-token only — never on the CAMARA library.</description>

  <dependencies>
    <dependency>
      <groupId>et.restlink</groupId>
      <artifactId>sas-common</artifactId>
    </dependency>
    <dependency>
      <groupId>et.restlink</groupId>
      <artifactId>sas-token</artifactId>
    </dependency>
    <!-- Ts43RequestEvent is a SLEE event (compile-only API). -->
    <dependency>
      <groupId>com.microjainslee</groupId>
      <artifactId>jainslee-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
    </dependency>

    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
