# local/editor noise
__pycache__/
*.pyc
.venv/
.idea/
.vscode/
*.iml
.DS_Store

# build output (never commit; keeps generated artifacts out of a public repo)
target/
.build/
node_modules/
dist/

# local H2 databases / runtime data — contains UAT CDR + session rows
*.mv.db
*.trace.db
sas-host/data/

# gradle / xcode noise for the SDK samples
.gradle/
build/
DerivedData/
xcuserdata/

# pitch decks — presentation artifacts, not source; kept out of the repo
slides/

# jSS7 stack state files — the MAP/SCTP/M3UA/SCCP/TCAP layers persist XML into CWD
# on start (that is how the stack reloads). They are lab runtime state, never source,
# and they are written wherever the process was started, so ignore them by name.
*-m3ua_*.xml
*-sccp_*.xml
*-sctp_*.xml
*-tcap_*.xml
*-map_*.xml
M3ua_*.xml
