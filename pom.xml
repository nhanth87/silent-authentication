<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>et.restlink</groupId>
  <artifactId>sas-core</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>sas-core</name>
  <description>Silent Auth SAS multi-module: CAMARA northbound (sas-api),
    TS.43/Wi-Fi entitlement track (sas-entitlement), runnable composition app
    (sas-host). Fail-closed Resolver -&gt; Verifier -&gt; Policy.</description>

  <modules>
    <module>sas-api</module>
    <module>sas-entitlement</module>
    <module>sas-host</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <quarkus.platform.version>3.37.3</quarkus.platform.version>
    <microjainslee.version>1.2.0-SNAPSHOT</microjainslee.version>
    <surefire.version>3.5.4</surefire.version>
    <compiler.plugin.version>3.14.0</compiler.plugin.version>
    <log4j2.version>2.23.1</log4j2.version>
    <jss7.version>9.2.8-j25</jss7.version>
    <corsac-diameter.version>10.0.0-41-SNAPSHOT</corsac-diameter.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>et.restlink</groupId>
        <artifactId>sas-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>et.restlink</groupId>
        <artifactId>sas-entitlement</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.microjainslee</groupId>
        <artifactId>jainslee-api</artifactId>
        <version>${microjainslee.version}</version>
      </dependency>
      <dependency>
        <groupId>com.microjainslee</groupId>
        <artifactId>jainslee-core</artifactId>
        <version>${microjainslee.version}</version>
      </dependency>
      <dependency>
        <groupId>com.microjainslee</groupId>
        <artifactId>jainslee-apt</artifactId>
        <version>${microjainslee.version}</version>
        <optional>true</optional>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler.plugin.version}</version>
          <configuration>
            <release>25</release>
            <annotationProcessorPaths>
              <path>
                <groupId>com.microjainslee</groupId>
                <artifactId>jainslee-api</artifactId>
                <version>${microjainslee.version}</version>
              </path>
              <path>
                <groupId>com.microjainslee</groupId>
                <artifactId>jainslee-apt</artifactId>
                <version>${microjainslee.version}</version>
              </path>
              <path>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
                <version>${log4j2.version}</version>
              </path>
              <path>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>${log4j2.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
