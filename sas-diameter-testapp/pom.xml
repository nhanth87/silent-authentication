<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>et.restlink</groupId>
  <artifactId>sas-diameter-testapp</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>SAS Diameter TestApp (HSS / 3GPP AAA simulator)</name>
  <description>Operator-side HSS + 3GPP AAA + PCRF (Gx) Diameter simulator for
    the Silent Auth SAS lab loop: browser/web -> POST /verify -> SAS -> this
    test app. Serves S6a (ULR/AIR/IDR, TS 29.272), SWx (MAR/SAR/PPR, TS 29.273)
    and Gx CCR binding lookups (TS 29.212) over corsac-diameter, plus a control
    web UI.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <corsac-diameter.version>10.0.0-41-SNAPSHOT</corsac-diameter.version>
    <log4j2.version>2.23.1</log4j2.version>
  </properties>

  <dependencies>
    <!-- Same corsac-diameter stack the SAS client uses (netty/sctp/timers are
         pulled in transitively). -->
    <dependency>
      <groupId>com.mobius-software.protocols.diameter</groupId>
      <artifactId>diameter-api</artifactId>
      <version>${corsac-diameter.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mobius-software.protocols.diameter</groupId>
      <artifactId>diameter-impl</artifactId>
      <version>${corsac-diameter.version}</version>
    </dependency>

    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
      <version>${log4j2.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <version>${log4j2.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>sas-diameter-testapp</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <release>25</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>et.restlink.testapp.Main</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
