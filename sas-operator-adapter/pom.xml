<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>et.restlink</groupId>
    <artifactId>sas-core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>sas-operator-adapter</artifactId>
  <name>sas-core :: sas-operator-adapter</name>
  <description>Signalling resource adaptors shared by both SAS binaries: MAP over
    M3UA/SCTP (jSS7 — PSI/SAI verify, SAI auth vectors, SendIMSI binding) and Diameter
    SWx (corsac — MAR/MAA, SAR/SAA), plus the auth-vector and subscriber-binding RAs.
    Every class here lives under /ras/ or is transport config: this is the only
    library allowed to import a signalling stack (gate H24). Each binary builds its
    own stack instance (own GT/SSN, own Diameter Origin-Host).</description>

  <dependencies>
    <dependency>
      <groupId>et.restlink</groupId>
      <artifactId>sas-common</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.microjainslee</groupId>
      <artifactId>jainslee-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
    </dependency>

    <!-- P2: real MAP transport (jSS7 coral-valley) -->
    <dependency>
      <groupId>org.restcomm.protocols.ss7.config</groupId>
      <artifactId>ss7-config</artifactId>
      <version>${jss7.version}</version>
    </dependency>
    <dependency>
      <groupId>org.restcomm.protocols.ss7.map</groupId>
      <artifactId>map-api</artifactId>
      <version>${jss7.version}</version>
    </dependency>
    <dependency>
      <groupId>org.restcomm.protocols.ss7.map</groupId>
      <artifactId>map-impl</artifactId>
      <version>${jss7.version}</version>
    </dependency>
    <!-- Kernel-SCTP dataplane (NETTY_KERNEL / JDK jdk.sctp). Without it on the runtime
         classpath Ss7StackBuilder cannot instantiate any SCTP backend — ss7-config only
         ships the F-Stack one — so the whole MAP transport fails at boot with
         "Cannot load SCTP backend NETTY_KERNEL". Lab/test fallback; production runs
         FSTACK_DPDK. Either way the SS7 link is SCTP, never TCP (RFC 4666 §3). -->
    <dependency>
      <groupId>org.mobicents.protocols.sctp</groupId>
      <artifactId>sctp-impl</artifactId>
      <version>2.27.32</version>
    </dependency>

    <!-- P2: real Diameter S6a / SWx transport (corsac-diameter) -->
    <dependency>
      <groupId>com.mobius-software.protocols.diameter</groupId>
      <artifactId>diameter-api</artifactId>
      <version>${corsac-diameter.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mobius-software.protocols.diameter</groupId>
      <artifactId>diameter-impl</artifactId>
      <version>${corsac-diameter.version}</version>
    </dependency>


    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
