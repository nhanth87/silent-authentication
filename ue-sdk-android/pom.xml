<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>et.restlink</groupId>
  <artifactId>ue-sdk-android</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Silent Auth UE SDK (Android)</name>
  <description>Device side of CAMARA Number Verification v2 on Android
    (minSdk 24): the OIDC authorization request over a requested cellular
    network, the TS.43 operator-token path for Wi-Fi, the desktop-to-phone QR
    claim and the SAS /session-tuple poster. Thin: java.net only, zero
    third-party runtime dependencies.</description>

  <licenses>
    <license>
      <name>GNU Affero General Public License v3.0 or later (Community edition)</name>
      <url>https://www.gnu.org/licenses/agpl-3.0.html</url>
      <distribution>manual</distribution>
      <comments>Dual licensed work; SPDX expression:
        AGPL-3.0-or-later OR LicenseRef-Silent-Auth-Operator-1.0. This entry is
        the AGPL Community grant only: copyleft, and AGPL section 13 also covers
        serving the software over a network. Production rights without copyleft,
        private builds, a permissive client option and L1/L2 SLA come from the
        proprietary Operator license held by the copyright owner; see LICENSE.md.
      </comments>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>8</maven.compiler.release>
    <surefire.version>3.5.4</surefire.version>
    <junit-jupiter.version>5.12.2</junit-jupiter.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit-jupiter.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <release>8</release>
        </configuration>
      </plugin>
      <!-- Compile-only android.net stubs (src/stubs/java): the three framework
           classes ConnectivityManager.requestNetwork() needs, because its
           NetworkCallback is a class to subclass and reflection cannot do that.
           They are excluded from the jar below; on a device the real framework
           classes with identical signatures are used. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>android-stubs</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>src/stubs/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <excludes>
            <exclude>android/**</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
      </plugin>
    </plugins>
  </build>
</project>
