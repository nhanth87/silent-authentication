{
  "name": "@restlink/ue-sdk-web",
  "version": "0.3.0",
  "description": "Silent Auth UE SDK (Web) - CAMARA Number Verification v2 in the browser (silent prompt=none authorization, callback parsing, SIM credential via the Digital Credentials API), the desktop half of the QR hand-off, and the session-tuple poster. Zero dependencies, ES2020.",
  "type": "module",
  "main": "src/session-tuple.js",
  "types": "src/session-tuple.d.ts",
  "exports": {
    ".": {
      "types": "./src/session-tuple.d.ts",
      "default": "./src/session-tuple.js"
    },
    "./qr-session": {
      "types": "./src/qr-session.d.ts",
      "default": "./src/qr-session.js"
    },
    "./number-verification": {
      "types": "./src/number-verification.d.ts",
      "default": "./src/number-verification.js"
    },
    "./hand-off": {
      "types": "./src/hand-off.d.ts",
      "default": "./src/hand-off.js"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "AGPL-3.0-or-later OR LicenseRef-Silent-Auth-Operator-1.0",
  "private": true,
  "author": "Tran Nhan (nhanth87)"
}
